# API Gateway
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000

# Microservice URLs
AUTH_SERVICE_URL=http://127.0.0.1:8001
COURSE_SERVICE_URL=http://127.0.0.1:8002
ENROLLMENT_SERVICE_URL=http://127.0.0.1:8003
ASSESSMENT_SERVICE_URL=http://127.0.0.1:8004
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8005
ANALYTICS_SERVICE_URL=http://127.0.0.1:8006

# PostgreSQL Database URLs
AUTH_DATABASE_URL=postgresql+psycopg://postgres:@localhost:5432/smart_learning_auth

COURSE_DATABASE_URL=postgresql+psycopg://postgres:@localhost:5432/smart_learning_courses

ENROLLMENT_DATABASE_URL=postgresql+psycopg://postgres:@localhost:5432/smart_learning_enrollments

ASSESSMENT_DATABASE_URL=postgresql+psycopg://postgres:@localhost:5432/smart_learning_assessments

NOTIFICATION_DATABASE_URL=postgresql+psycopg://postgres:@localhost:5432/smart_learning_notifications

# JWT Configuration
SECRET_KEY=REPLACE_WITH_YOUR_GENERATED_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_google_app_password

# Frontend Configuration
FRONTEND_URL=http://localhost:5173
